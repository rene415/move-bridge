<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Bring the audio-only helper back after a phone restart (HelperJob), once the phone is on Wi-Fi. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Audio-only mode: talk to this phone's own Wireless debugging (localhost only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Granted only through Wireless debugging (pm grant), and only if "Start automatically" is on:
         lets the app switch Wireless debugging on briefly after a restart to start its helper. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />


    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:theme="@style/Theme.MoveBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible: Android opens this when the Move is plugged in; it connects and closes. -->
        <activity
            android:name=".ConnectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity=""
            android:theme="@style/Theme.MoveBridge.Invisible">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- One-time setup guide, and feedback for beta testers (nothing is sent by the app itself). -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.FeedbackActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Quick Settings tile: start and stop sending from the pull-down panel. -->
        <service
            android:name=".BridgeTile"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- After a restart or an update: start the audio-only helper in the background. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".HelperJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|connectedDevice"
            tools:ignore="ForegroundServicePermission" />
        <!-- connectedDevice: the prerequisite we meet is USB permission for the Move (granted via
             UsbManager), which lint can't check statically. -->

        <!-- Receives the binder of Move Bridge's own shell helper. Only shell/system can call it. -->
        <provider
            android:name=".ShellLinkProvider"
            android:authorities="${applicationId}.shell"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Pairing code typed into the setup notification. -->
        <receiver
            android:name=".adb.PairingReceiver"
            android:exported="false" />

    </application>
</manifest>
