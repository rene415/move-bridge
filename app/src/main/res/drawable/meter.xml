<?xml version="1.0" encoding="utf-8"?>
<!-- Level meter: flat track with a solid accent fill, like Live's meters. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_hi" />
            <stroke android:width="1dp" android:color="@color/outline" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/accent" />
            </shape>
        </scale>
    </item>
</layer-list>
