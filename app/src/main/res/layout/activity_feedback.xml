<?xml version="1.0" encoding="utf-8"?>
<!-- Feedback and bug reports (FeedbackActivity). The app sends nothing itself: this screen builds a
     text the user can read, then hands it to the share sheet, a GitHub issue or the clipboard. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/feedback_title"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/feedback_intro"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <!-- Privacy promise -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_note"
            android:orientation="vertical"
            android:paddingVertical="12dp"
            android:paddingStart="15dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/Label"
                android:text="@string/privacy_label"
                android:textColor="@color/accent_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/privacy_body"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:text="@string/feedback_kind_label" />

            <RadioGroup
                android:id="@+id/feedbackKinds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:labelFor="@+id/feedbackNote"
                android:text="@string/feedback_note_label" />

            <EditText
                android:id="@+id/feedbackNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <CheckBox
                android:id="@+id/feedbackDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/feedback_details"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/feedback_details_body"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/feedbackPreviewToggle"
                style="@style/Label"
                android:layout_width="match_parent"
                android:paddingVertical="12dp"
                android:text="@string/feedback_preview"
                android:textColor="@color/accent_text" />

            <TextView
                android:id="@+id/feedbackPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_dim"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/feedbackSend"
            style="@style/PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="@string/feedback_send" />

        <Button
            android:id="@+id/feedbackGithub"
            style="@style/SecondaryButton"
            android:layout_marginTop="8dp"
            android:text="@string/feedback_github" />

        <Button
            android:id="@+id/feedbackCopy"
            style="@style/SecondaryButton"
            android:layout_marginTop="8dp"
            android:text="@string/feedback_copy" />
    </LinearLayout>
</ScrollView>
