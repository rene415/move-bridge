<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded notification body (RemoteViews): status line and a big Stop button.
     Collapsed, there is only room for the button: see notif_bridge_small.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/notifTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <TextView
        android:id="@+id/notifStop"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_notif_stop"
        android:gravity="center"
        android:textColor="@color/on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
