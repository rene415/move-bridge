<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ===== Main screen ===== -->
    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_foreground" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_name"
                        android:textColor="@color/text"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tagline"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Android-only note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_note"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:paddingStart="15dp"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/Label"
                    android:text="@string/android_only_label"
                    android:textColor="@color/accent_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/android_only_body"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Status card -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="10dp"
                android:paddingVertical="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot" />

                    <TextView
                        android:id="@+id/phaseLabel"
                        style="@style/Label"
                        android:layout_marginStart="10dp"
                        android:text="@string/phase_idle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/state_idle_title"
                    android:textColor="@color/text"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/state_idle_detail"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/meterRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_marginEnd="12dp"
                        android:text="@string/level" />

                    <ProgressBar
                        android:id="@+id/meter"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="0"
                        android:progressDrawable="@drawable/meter" />
                </LinearLayout>

                <Button
                    android:id="@+id/primary"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="20dp"
                    android:text="@string/btn_start" />

                <Button
                    android:id="@+id/tone"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_tone" />
            </LinearLayout>

            <!-- How to sample -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Label"
                    android:text="@string/on_the_move" />

                <LinearLayout
                    android:id="@+id/steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/step_tip"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <!-- A plain text link: Ableton's own pictures of these screens are in its manual. -->
                <TextView
                    android:id="@+id/linkManual"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:text="@string/link_manual"
                    android:textColor="@color/accent_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Settings: rows use layout/setting_row.xml; texts and visibility come from SettingsPanel. -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Label"
                    android:layout_marginBottom="4dp"
                    android:text="@string/settings" />

                <!-- A to-do, not a setting: shown only while the one-time setup needs something. -->
                <include
                    android:id="@+id/rowSetup"
                    layout="@layout/setting_row" />

                <include
                    android:id="@+id/rowAuto"
                    layout="@layout/setting_row" />

                <include
                    android:id="@+id/rowMute"
                    layout="@layout/setting_row" />

                <!-- Shown once the one-time setup is done. -->
                <include
                    android:id="@+id/rowPlayOnPhone"
                    layout="@layout/setting_row" />

                <include
                    android:id="@+id/rowAutoRestart"
                    layout="@layout/setting_row" />

                <!-- Screen-share capture only: shown while the one-time setup isn't done. -->
                <include
                    android:id="@+id/rowArmed"
                    layout="@layout/setting_row" />
            </LinearLayout>

            <!-- Details (tap to expand) -->
            <LinearLayout
                style="@style/Card"
                android:id="@+id/detailsCard">

                <TextView
                    android:id="@+id/detailsToggle"
                    style="@style/Label"
                    android:layout_width="match_parent"
                    android:text="@string/details_closed" />

                <TextView
                    android:id="@+id/stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_dim"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Beta: feedback, what's new, setup guide, Quick Settings tile -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/Label"
                    android:text="@string/beta_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/beta_body"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/feedback"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/beta_feedback" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/linkWhatsNew"
                        style="@style/Link"
                        android:text="@string/link_whats_new" />

                    <TextView
                        android:id="@+id/linkSetup"
                        style="@style/Link"
                        android:text="@string/link_setup" />

                    <TextView
                        android:id="@+id/linkTile"
                        style="@style/Link"
                        android:text="@string/link_tile" />
                </LinearLayout>
            </LinearLayout>

            <!-- Trademark notice (required by Ableton's branding guidelines) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/trademark"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/linkLicenses"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:text="@string/link_licenses"
                android:textColor="@color/accent_text"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== First-run intro ===== -->
    <LinearLayout
        android:id="@+id/intro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_icon"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/intro_title"
            android:textColor="@color/text"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/intro_body"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/intro_next"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/introContinue"
            style="@style/PrimaryButton"
            android:layout_marginTop="32dp"
            android:text="@string/intro_continue" />
    </LinearLayout>
</FrameLayout>
